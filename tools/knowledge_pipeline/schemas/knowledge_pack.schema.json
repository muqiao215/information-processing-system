{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muqiao.local/schemas/knowledge_pack.schema.json",
  "title": "Knowledge Pack",
  "type": "object",
  "required": [
    "schema_version",
    "pack_id",
    "date",
    "generated_at",
    "item_count",
    "items",
    "input_manifests",
    "preprocessing_summary",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generated_at": {
      "type": "string"
    },
    "item_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "input_manifests": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "exists"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "exists": {
            "type": "boolean"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "selection_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "item_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "preprocessing_summary": {
      "type": "object",
      "required": [
        "status_counts",
        "method_counts",
        "localized_source_types",
        "cache_root",
        "generated_at",
        "notes"
      ],
      "properties": {
        "status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "method_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "localized_source_types": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "cache_root": {
          "type": [
            "string",
            "null"
          ]
        },
        "generated_at": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "fallback_markdown_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "item_id",
        "source_id",
        "source_type",
        "source_of_truth",
        "access_path",
        "title",
        "summary",
        "raw_text",
        "selected_reason",
        "tags",
        "freshness",
        "content_type",
        "import_targets",
        "import_policy",
        "fallback_content",
        "preprocess",
        "metadata"
      ],
      "properties": {
        "item_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "source_of_truth": {
          "type": "string"
        },
        "access_path": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "raw_text": {
          "type": "string"
        },
        "selected_reason": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness": {
          "type": "object",
          "required": [
            "published_at",
            "generated_at"
          ],
          "properties": {
            "published_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "generated_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "content_type": {
          "type": "string"
        },
        "local_text_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "import_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "import_policy": {
          "type": "object",
          "required": [
            "preferred",
            "fallback"
          ],
          "properties": {
            "preferred": {
              "type": "string"
            },
            "fallback": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "fallback_content": {
          "type": "string"
        },
        "preprocess": {
          "type": "object",
          "required": [
            "status",
            "method",
            "local_text_path",
            "source_url",
            "content_length",
            "attempted_methods",
            "notes",
            "generated_at"
          ],
          "properties": {
            "status": {
              "type": "string"
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "local_text_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_url": {
              "type": [
                "string",
                "null"
              ]
            },
            "content_length": {
              "type": "integer",
              "minimum": 0
            },
            "attempted_methods": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "method",
                  "ok",
                  "detail"
                ],
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "generated_at": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
